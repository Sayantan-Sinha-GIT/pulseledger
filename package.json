{
  "name": "pulseledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Uptime and incident dashboard for independently operated services",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.worker.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "test": "vitest run && node scripts/verify-read-budget-migration.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply pulseledger-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulseledger-db --remote",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "clean:e2e": "node scripts/clean-e2e.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm audit --audit-level=high"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "5.20261101.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
